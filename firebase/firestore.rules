rules_version = '2';

// Firestore 보안 규칙
// 이 게임의 랭킹 데이터(leaderboards)는 오직 서버(firebase-admin, 서비스 계정)만
// 읽고 씁니다. 브라우저 클라이언트는 서버의 /api/leaderboard 를 통해서만 조회하므로
// 클라이언트의 직접 접근은 전부 차단합니다. (치팅 방지)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
