# Neon pooled PostgreSQL connection string (copy from Neon Console → Connect).
# Keep the actual value in .env.local; never commit credentials.
DATABASE_URL=

# 우리말샘 오픈 API (https://opendict.korean.go.kr/service/openApiInfo 에서 발급)
# 키는 서버에서만 사용하며 브라우저에 노출하지 않습니다.
OPENDICT_API_KEY=

# Firebase Admin 서비스 계정(JSON 또는 base64) — Google 로그인·Firestore 랭킹
# 미설정 시 Google 로그인/랭크/채팅/관리자 기능이 비활성화됩니다.
FIREBASE_SERVICE_ACCOUNT=

# 관리자 Google 계정 이메일 allowlist (쉼표 구분, 미설정 시 코드의 기본값 사용)
ADMIN_EMAILS=

# 런타임 데이터(플레이어/채팅/제재/길드 등) 저장 경로 — 선택 (예: /app/data)
KK_DATA_DIR=

# 슬립 방지 핑 대상 공개 URL — 선택 (Render는 RENDER_EXTERNAL_URL 자동 사용)
KK_PUBLIC_URL=

# 계정 복구 코드 해시에 쓰는 비밀 pepper — 미설정 시 기본값. 운영에서는 반드시 고유값을 설정하세요.
# 값을 바꾸면 기존 복구 코드가 모두 무효가 됩니다.
RECOVERY_PEPPER=
