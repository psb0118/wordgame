# Neon pooled PostgreSQL connection string (copy from Neon Console → Connect).
# Keep the actual value in .env.local; never commit credentials.
DATABASE_URL=

# 우리말샘 오픈 API (https://opendict.korean.go.kr/service/openApiInfo 에서 발급)
# 키는 서버에서만 사용하며 브라우저에 노출하지 않습니다.
OPENDICT_API_KEY=

# Firebase Admin 서비스 계정(JSON 또는 base64) — Google 로그인·Firestore 랭킹
# 미설정 시 Google 로그인/랭크/채팅/관리자 기능이 비활성화됩니다.
FIREBASE_SERVICE_ACCOUNT=

# 관리자 Google 계정 이메일 allowlist (쉼표 구분, 미설정 시 코드의 기본값 사용)
ADMIN_EMAILS=

# 런타임 데이터(플레이어/채팅/제재/길드 등) 저장 경로 — 선택 (예: /app/data)
KK_DATA_DIR=

# 슬립 방지 핑 대상 공개 URL — 선택 (Render는 RENDER_EXTERNAL_URL 자동 사용)
KK_PUBLIC_URL=

# 계정 복구 코드 해시에 쓰는 비밀 pepper — 미설정 시 기본값. 운영에서는 반드시 고유값을 설정하세요.
# 값을 바꾸면 기존 복구 코드가 모두 무효가 됩니다.
RECOVERY_PEPPER=

# 다중 인스턴스 — 단일 게임 코어 + 웹 릴레이
# 한 인스턴스로 운영할 때는 모두 비워 두면 됩니다.
# 게임 코어: CLUSTER_ROLE=game
# 웹 릴레이: CLUSTER_ROLE=web + CLUSTER_GAME_URL=https://게임코어주소
CLUSTER_ROLE=
CLUSTER_GAME_URL=
# 이 인스턴스의 공개/내부 주소(관측용). 예: https://wordgame.onrender.com
CLUSTER_NODE_URL=
# 웹 릴레이에서 상태성 /api 요청도 게임 코어로 보낼지 (기본 1)
CLUSTER_PROXY_API=1
# 인스턴스 식별자 — 미설정 시 hostname-pid
CLUSTER_INSTANCE_ID=
# 게임 코어 lease TTL/대기 시간(ms). 대기 시간은 TTL보다 길게 두는 것이 좋습니다.
CLUSTER_LEASE_TTL_MS=30000
CLUSTER_LEASE_WAIT_MS=35000
# DB가 있는데 공유 상태 테이블을 만들 수 없을 때 게임 코어 시작을 거부 (기본 1)
CLUSTER_REQUIRE_LEASE=1
